{
  "name": "recruitment-platform",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "predev": "pnpm build",
    "dev": "pnpm -r --parallel dev",
    "infra:up": "node scripts/infra.mjs up -d",
    "infra:stop": "node scripts/infra.mjs stop",
    "infra:check": "pnpm --filter @recruitment/api infra:check"
  }
}
