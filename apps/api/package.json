{
  "name": "@recruitment/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "predev": "pnpm build",
    "dev": "concurrently -k -n compiler,server \"tsc --watch\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "node --test tests/*.test.mjs",
    "infra:check": "node tests/infra-smoke.mjs",
    "auth:migrate": "node dist/auth/migrate.js",
    "db:migrate": "node dist/database/migrate.js",
    "vacancies:check": "node tests/vacancies-smoke.mjs",
    "applications:check": "node tests/applications-smoke.mjs",
    "processing:run": "node dist/processing/process.js",
    "processing:check": "node tests/applications-smoke.mjs --processing",
    "auth:check": "node tests/auth-smoke.mjs",
    "auth:mock-check": "node tests/auth-memory-smoke.mjs",
    "integrations:check": "node --test tests/integrations.test.mjs",
    "mail:latest": "node dist/integrations/mail/read-local-mail.js",
    "staff:provision": "node dist/auth/provision-staff.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@recruitment/domain": "workspace:*",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "multer": "2.4.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.0",
    "redis": "^5.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "^5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0"
  }
}
