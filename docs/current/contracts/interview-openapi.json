{
  "openapi":"3.1.0",
  "info":{"title":"Recruitment interviews and inbox — implemented","version":"0.6.0","description":"Internal pipeline/scheduling/assessment/inbox. Detailed policy: interview-api.md. All POST actions return 201; PUT/GET 200. Writes require trusted Origin. No candidate messaging or live AI."},
  "servers":[{"url":"http://localhost:3000/api"}],
  "security":[{"sessionCookie":[]}],
  "paths":{
    "/vacancies/{id}/interview-pipeline":{"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"getInterviewPipeline","summary":"HR reads owner-managed steps","responses":{"200":{"$ref":"#/components/responses/Pipeline"},"default":{"$ref":"#/components/responses/Error"}}},"put":{"operationId":"saveInterviewPipeline","summary":"Owner replaces steps before scheduling","description":"Owner, expected interview revision and scheduling-freeze checks precede comparison under the vacancy lock. An identical normalized ordered list, including empty, preserves IDs and revision without writes; stale/frozen-identical requests still return 409. Names/instructions are trimmed and omitted instructions default to empty. Real changes retain replace-all/new-ID semantics and increment interview_revision once. Publication-time freezing and UI changes are not implemented here.","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PipelineWrite"}}}},"responses":{"200":{"$ref":"#/components/responses/Pipeline"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/vacancies/{id}/interview-results":{"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"getInterviewResults","summary":"HR paginated candidate-by-step results","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"}],"responses":{"200":{"description":"Pipeline metadata plus candidate items/total/limit/offset; see interview-api.md","content":{"application/json":{"schema":{"type":"object"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviewers":{"get":{"operationId":"listInterviewers","summary":"HR list of existing staff, max 200","responses":{"200":{"description":"Staff identity items","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Person"}}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/applications/{id}/interviews":{"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"getApplicationInterviews","summary":"HR workflow and interviews","responses":{"200":{"$ref":"#/components/responses/Workflow"},"default":{"$ref":"#/components/responses/Error"}}},"post":{"operationId":"scheduleInterview","summary":"HR schedules application step","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateInterview"}}}},"responses":{"201":{"$ref":"#/components/responses/Interview"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/applications/{id}/stage":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"changeRecruitmentStage","summary":"HR preselection, owner finalization; no reopening","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["expectedRevision","stage"],"properties":{"expectedRevision":{"type":"integer","minimum":1},"stage":{"enum":["preselected","not_selected","offer","hired"]},"reason":{"type":"string","minLength":1,"maxLength":2000}}}}}},"responses":{"201":{"$ref":"#/components/responses/Workflow"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews":{"get":{"operationId":"listInterviewAgenda","summary":"HR all or interviewer assigned; max 93-day range","parameters":[{"name":"from","in":"query","required":true,"schema":{"type":"string","format":"date-time"}},{"name":"to","in":"query","required":true,"schema":{"type":"string","format":"date-time"}},{"name":"view","in":"query","schema":{"enum":["agenda","feedback","cancelled"],"default":"agenda"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"}],"responses":{"200":{"description":"Paginated interview projections","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Interview"}},"total":{"type":"integer"},"limit":{"type":"integer"},"offset":{"type":"integer"}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}":{"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"getInterview","summary":"HR or current assignee; includes canAssess/canSchedule","responses":{"200":{"$ref":"#/components/responses/Interview"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}/schedule":{"parameters":[{"$ref":"#/components/parameters/Id"}],"put":{"operationId":"rescheduleInterview","summary":"HR reschedules/reassigns, clears scheduling issue","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Schedule"}}}},"responses":{"200":{"$ref":"#/components/responses/Interview"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}/cancel":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"cancelInterview","summary":"HR cancels appointment, not application","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"$ref":"#/components/requestBodies/Reason"},"responses":{"201":{"$ref":"#/components/responses/Interview"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}/scheduling-issue":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"requestInterviewRescheduling","summary":"Assigned interviewer flags scheduling issue for creator and owner","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"$ref":"#/components/requestBodies/Reason"},"responses":{"201":{"$ref":"#/components/responses/Interview"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}/feedback":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"submitInterviewFeedback","summary":"Assignee submits final notes/score/Pass or terminal Fail","description":"After start time. Fail ends application and cancels every other unfinished interview atomically. Pass never accepts. No edits/reopening.","parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["expectedRevision","notes","outcome"],"properties":{"expectedRevision":{"type":"integer","minimum":1},"notes":{"type":"string","minLength":1,"maxLength":10000},"score":{"type":["integer","null"],"minimum":0,"maximum":10},"outcome":{"enum":["pass","fail"]}}}}}},"responses":{"201":{"$ref":"#/components/responses/Interview"},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}/application":{"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"getAssignedInterviewApplication","summary":"Scoped immutable answers/documents; cancelled-only assignment denied","responses":{"200":{"description":"Application projection; no processingDefinition/review for interviewer","content":{"application/json":{"schema":{"type":"object"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/interviews/{id}/documents/{documentId}":{"parameters":[{"$ref":"#/components/parameters/Id"},{"name":"documentId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"downloadAssignedInterviewDocument","summary":"Scoped private integrity-checked attachment","responses":{"200":{"description":"Original bytes, private/no-store, octet-stream/nosniff","content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/inbox":{"get":{"operationId":"listInbox","summary":"Own staff notifications, unread default","parameters":[{"name":"read","in":"query","schema":{"enum":["unread","all"],"default":"unread"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"}],"responses":{"200":{"description":"Own messages plus total/limit/offset","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Notification"}},"total":{"type":"integer"},"limit":{"type":"integer"},"offset":{"type":"integer"}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/inbox/{id}/read":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"markNotificationRead","summary":"Own notification only; retain first read timestamp","parameters":[{"$ref":"#/components/parameters/Origin"}],"responses":{"201":{"description":"id/readAt","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"readAt":{"type":"string","format":"date-time"}}}}}},"default":{"$ref":"#/components/responses/Error"}}}}
  },
  "components":{
    "securitySchemes":{"sessionCookie":{"type":"apiKey","in":"cookie","name":"better-auth.session_token"}},
    "parameters":{
      "Id":{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "Origin":{"name":"Origin","in":"header","required":true,"schema":{"type":"string"},"description":"Trusted configured web/API origin"},
      "Limit":{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},
      "Offset":{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"maximum":100000,"default":0}}
    },
    "requestBodies":{"Reason":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["expectedRevision","reason"],"properties":{"expectedRevision":{"type":"integer","minimum":1},"reason":{"type":"string","minLength":1,"maxLength":2000}}}}}}},
    "schemas":{
      "ActionAvailability":{"$ref":"./openapi.json#/components/schemas/ActionAvailability"},
      "InterviewPlanActions":{"type":"object","additionalProperties":false,"required":["edit"],"properties":{"edit":{"$ref":"#/components/schemas/ActionAvailability"}}},
      "WorkflowActions":{"type":"object","additionalProperties":false,"required":["preselect","reject","offer","hire","schedule"],"properties":{"preselect":{"$ref":"#/components/schemas/ActionAvailability"},"reject":{"$ref":"#/components/schemas/ActionAvailability"},"offer":{"$ref":"#/components/schemas/ActionAvailability"},"hire":{"$ref":"#/components/schemas/ActionAvailability"},"schedule":{"$ref":"#/components/schemas/ActionAvailability"}}},
      "InterviewActions":{"type":"object","additionalProperties":false,"required":["reschedule","cancel","requestRescheduling","submitFeedback","readApplication"],"properties":{"reschedule":{"$ref":"#/components/schemas/ActionAvailability"},"cancel":{"$ref":"#/components/schemas/ActionAvailability"},"requestRescheduling":{"$ref":"#/components/schemas/ActionAvailability"},"submitFeedback":{"$ref":"#/components/schemas/ActionAvailability"},"readApplication":{"$ref":"#/components/schemas/ActionAvailability"}}},
      "Person":{"type":"object","required":["id","name","email"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"email":{"type":"string","format":"email"}}},
      "StepWrite":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100},"instructions":{"type":"string","maxLength":4000,"default":""}}},
      "Step":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"position":{"type":"integer","minimum":0,"maximum":9},"name":{"type":"string"},"instructions":{"type":"string"}}},
      "PipelineWrite":{"type":"object","additionalProperties":false,"required":["expectedRevision","steps"],"properties":{"expectedRevision":{"type":"integer","minimum":1},"steps":{"type":"array","maxItems":10,"items":{"$ref":"#/components/schemas/StepWrite"}}}},
      "Pipeline":{"type":"object","required":["actions"],"properties":{"vacancyId":{"type":"string","format":"uuid"},"revision":{"type":"integer"},"owner":{"$ref":"#/components/schemas/Person"},"editable":{"type":"boolean"},"frozen":{"type":"boolean"},"steps":{"type":"array","items":{"$ref":"#/components/schemas/Step"}},"actions":{"$ref":"#/components/schemas/InterviewPlanActions"}}},
      "Schedule":{"type":"object","additionalProperties":false,"required":["expectedRevision","interviewerId","startsAt","durationMinutes","timezone","meeting"],"properties":{"expectedRevision":{"type":"integer","minimum":1},"interviewerId":{"type":"string","minLength":1,"maxLength":200},"startsAt":{"type":"string","format":"date-time","description":"Future instant, local minute 00 or 30, seconds 0"},"durationMinutes":{"enum":[30,60,90,120]},"timezone":{"type":"string","minLength":1,"maxLength":100},"meeting":{"type":"string","minLength":1,"maxLength":1000}}},
      "CreateInterview":{"type":"object","additionalProperties":false,"required":["expectedRevision","stepId","interviewerId","startsAt","durationMinutes","timezone","meeting"],"properties":{"expectedRevision":{"type":"integer","minimum":1,"description":"Application workflow revision"},"stepId":{"type":"string","format":"uuid"},"interviewerId":{"type":"string","minLength":1,"maxLength":200},"startsAt":{"type":"string","format":"date-time"},"durationMinutes":{"enum":[30,60,90,120]},"timezone":{"type":"string","minLength":1,"maxLength":100},"meeting":{"type":"string","minLength":1,"maxLength":1000}}},
      "Cause":{"type":"object","required":["type","actorId"],"properties":{"type":{"enum":["hr_scheduled","hr_rescheduled","hr_cancelled","hr_ended_application","interview_failed","feedback_submitted","reschedule_requested"]},"actorId":{"type":"string"},"reason":{"type":"string"},"interviewId":{"type":"string","format":"uuid"},"stepName":{"type":"string"}}},
      "Interview":{"type":"object","required":["id","applicationId","vacancyId","stepId","revision","status","startsAt","interviewer","owner","actions"],"properties":{"id":{"type":"string","format":"uuid"},"applicationId":{"type":"string","format":"uuid"},"vacancyId":{"type":"string","format":"uuid"},"stepId":{"type":"string","format":"uuid"},"stepName":{"type":"string"},"instructions":{"type":"string"},"vacancyTitle":{"type":"string"},"candidate":{"type":"object","properties":{"name":{"type":"string"},"email":{"type":"string"}}},"applicationStage":{"type":"string"},"revision":{"type":"integer","minimum":1},"status":{"enum":["scheduled","completed","cancelled"]},"startsAt":{"type":"string","format":"date-time"},"durationMinutes":{"enum":[30,60,90,120]},"timezone":{"type":"string"},"meeting":{"type":"string"},"interviewer":{"$ref":"#/components/schemas/Person"},"owner":{"$ref":"#/components/schemas/Person"},"notes":{"type":["string","null"]},"score":{"type":["integer","null"],"minimum":0,"maximum":10},"outcome":{"enum":["pass","fail",null]},"submittedAt":{"type":["string","null"],"format":"date-time"},"cancellationCause":{"anyOf":[{"$ref":"#/components/schemas/Cause"},{"type":"null"}]},"changeCause":{"$ref":"#/components/schemas/Cause"},"schedulingIssue":{"type":["string","null"]},"issueAt":{"type":["string","null"],"format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"canAssess":{"type":"boolean"},"canSchedule":{"type":"boolean"},"actions":{"$ref":"#/components/schemas/InterviewActions"}}},
      "Workflow":{"type":"object","required":["actions"],"properties":{"applicationId":{"type":"string","format":"uuid"},"stage":{"enum":["received","review_ready","preselected","interview","offer","hired","not_selected"]},"revision":{"type":"integer","minimum":1},"owner":{"$ref":"#/components/schemas/Person"},"isOwner":{"type":"boolean"},"steps":{"type":"array","items":{"$ref":"#/components/schemas/Step"}},"interviews":{"type":"array","items":{"$ref":"#/components/schemas/Interview"}},"actions":{"$ref":"#/components/schemas/WorkflowActions"}}},
      "Notification":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"kind":{"enum":["assigned","rescheduled","cancelled","scheduling_issue","feedback","screening"]},"title":{"type":"string"},"body":{"type":"string"},"cause":{"anyOf":[{"$ref":"#/components/schemas/Cause"},{"type":"object","properties":{"type":{"const":"screening"},"decision":{"enum":["preselected","rejected"]}}}]},"createdAt":{"type":"string","format":"date-time"},"readAt":{"type":["string","null"],"format":"date-time"},"interviewId":{"type":["string","null"],"format":"uuid"},"applicationId":{"type":["string","null"],"format":"uuid"}}}
    },
    "responses":{
      "Error":{"description":"400 invalid body/time/UUID; 401 unauthenticated; 403 role/owner/Origin denied; 404 missing/inaccessible; 409 stale revision/overlap/final state; 503 document storage/integrity failure. JSON statusCode/message/error.","content":{"application/json":{"schema":{"type":"object","properties":{"statusCode":{"type":"integer"},"message":{"type":"string"},"error":{"type":"string"}}}}}},
      "Pipeline":{"description":"Private pipeline metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Pipeline"}}}},
      "Interview":{"description":"Private interview projection","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Interview"}}}},
      "Workflow":{"description":"Internal application workflow","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workflow"}}}}
    }
  }
}
