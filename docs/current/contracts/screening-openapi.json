{
  "openapi":"3.1.0",
  "info":{"title":"Screening export/import extension","version":"2026-11-07","description":"Requires unapplied migration 007. See screening-api.md for bounds, guards, filtering and deployment/verification limits. Existing application-list and inbox extensions are described there as well."},
  "servers":[{"url":"/api"}],
  "security":[{"sessionCookie":[]}],
  "paths":{
    "/vacancies/{id}/screening-export":{
      "parameters":[{"$ref":"#/components/parameters/VacancyId"}],
      "get":{"operationId":"exportUndecidedScreening","description":"HR-only full evidence CSV, always undecided; optional processing/review and inclusive from/exclusive before UTC dates. No reservations or export history.","parameters":[{"name":"processing","in":"query","schema":{"$ref":"./openapi.json#/components/schemas/ProcessingState"}},{"name":"review","in":"query","schema":{"enum":["pending","in_review","completed"]}},{"name":"from","in":"query","schema":{"type":"string","format":"date"}},{"name":"before","in":"query","schema":{"type":"string","format":"date"}},{"name":"undecided","in":"query","description":"Accepted for list-filter compatibility; export always forces undecided.","schema":{"enum":["true","false"]}}],"responses":{"200":{"description":"CSV, 1000 applications/10 MiB cap","content":{"text/csv":{"schema":{"type":"string"}}}}}}
    },
    "/vacancies/{id}/screening/preview":{
      "parameters":[{"$ref":"#/components/parameters/VacancyId"}],
      "post":{"operationId":"previewScreeningCsv","description":"HR/Origin-guarded read-only validation. Unknown extra CSV columns ignored; ID/email/decision required, optional internal reason. Invalid and already-decided rows distinguished.","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"additionalProperties":false,"properties":{"file":{"type":"string","format":"binary"}}}}}},"responses":{"201":{"description":"Preview, no decisions or notifications","content":{"application/json":{"schema":{"type":"object","required":["rows"],"properties":{"rows":{"type":"array","maxItems":1000,"items":{"$ref":"#/components/schemas/PreviewRow"}}}}}}},"400":{"description":"Invalid UTF-8/file/header"},"413":{"description":"Upload too large"}}}
    },
    "/vacancies/{id}/screening/apply":{
      "parameters":[{"$ref":"#/components/parameters/VacancyId"}],
      "post":{"operationId":"applyScreeningSelection","description":"HR/Origin-guarded atomic included-set apply. First committed decision wins. No automatic replay or silent partial apply.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["rows"],"additionalProperties":false,"properties":{"rows":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/components/schemas/Selection"}}}}}}},"responses":{"201":{"description":"Committed outcomes","content":{"application/json":{"schema":{"type":"object","properties":{"applied":{"type":"integer"},"preselected":{"type":"integer"},"rejected":{"type":"integer"}}}}}},"400":{"description":"Invalid or duplicate included rows"},"409":{"description":"No changes from this confirmation; safe row conflicts","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string"},"conflicts":{"type":"array","items":{"type":"object","properties":{"applicationId":{"type":"string"},"state":{"enum":["invalid","decided"]},"issue":{"type":"string"}}}}}}}}},"413":{"description":"Confirmation exceeds 10 MiB"}}}
    }
  },
  "components":{
    "securitySchemes":{"sessionCookie":{"$ref":"./openapi.json#/components/securitySchemes/sessionCookie"}},
    "parameters":{"VacancyId":{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}},
    "schemas":{
      "Selection":{"type":"object","additionalProperties":false,"required":["applicationId","email","decision","expectedRevision"],"properties":{"applicationId":{"type":"string","format":"uuid"},"email":{"type":"string","format":"email","maxLength":320},"decision":{"enum":["preselected","rejected"]},"reason":{"type":"string","maxLength":2000},"expectedRevision":{"type":"integer","minimum":1}}},
      "PreviewRow":{"type":"object","required":["key","applicationId","email","decision","reason","state","issue","candidate","revision"],"properties":{"key":{"type":"integer"},"applicationId":{"type":"string"},"email":{"type":"string"},"decision":{"type":"string"},"reason":{"type":"string"},"state":{"enum":["valid","invalid","decided"]},"issue":{"type":["string","null"]},"revision":{"type":["integer","null"]},"candidate":{"anyOf":[{"type":"null"},{"type":"object","properties":{"name":{"type":"string"},"email":{"type":"string"}}}]}}}
    }
  }
}
