// Source: docs/current/contracts/processing-review-api.md. Success path, not a job topology.
digraph Processing {
  graph [rankdir=TB, bgcolor="transparent", pad=0.15, nodesep=0.3, ranksep=0.4, splines=polyline, fontname="Liberation Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#f0f7f6", color="#0f766e", fontcolor="#172b4d", fontname="Liberation Sans", fontsize=22, margin="0.18,0.12", penwidth=1.4];
  edge [fontname="Liberation Sans", fontsize=20, color="#64748b", fontcolor="#475569", penwidth=1.3];
  pdf [label="PDF privé\noriginal"];
  markdown [label="Lecteur natif local\npdf-inspector → Markdown"];
  builder [label="Constructeur de requête\nMarkdown + questions / critères\n+ date de première publication"];
  request [label="JevGateway\nadmission et transport", fillcolor="#fff8eb", color="#b7791f"];
  jev [label="Jev · TypeSafe\nUne requête multi-question"];
  validated [label="Validation complète\nréponses typées / distributions"];
  result [label="Original enregistré\nchamps + réponse brute"];
  human [label="Revue RH / corrections\nséparées par champ"];
  effective [label="Valeurs effectives\nrevue / export"];
  parserCache [label="Cache de préparation\nPDF + lecteur / options", style="rounded,dashed,filled", fillcolor="#f8fafc", color="#64748b", fontsize=18];
  responseCache [label="Cache de réponse validée\nrequête effective complète", style="rounded,dashed,filled", fillcolor="#f8fafc", color="#64748b", fontsize=18];
  {rank=same; pdf; markdown; builder;}
  {rank=same; validated; jev; request;}
  {rank=same; result; human; effective;}
  pdf -> markdown -> builder;
  builder -> request;
  request -> jev -> validated [constraint=false];
  validated -> jev -> request [style=invis];
  markdown -> parserCache [style=dashed, arrowhead=none];
  parserCache -> jev [style=invis];
  validated -> responseCache [style=dashed, arrowhead=none];
  responseCache -> result [style=invis];
  validated -> result;
  result -> human [constraint=false];
  human -> effective [constraint=false];
  result -> human -> effective [style=invis];
}
