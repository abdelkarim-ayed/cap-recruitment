digraph Architecture {
graph [rankdir=LR, bgcolor="transparent", pad=0.15, nodesep=0.3, ranksep=0.45, fontname="Liberation Sans", splines=polyline];
node [fontname="Liberation Sans", fontsize=22, color="#0f766e", fontcolor="#172b4d", penwidth=1.3];
edge [fontname="Liberation Sans", fontsize=18, color="#64748b", fontcolor="#475569", penwidth=1.2];
node [shape=box, style="rounded,filled", fillcolor="#f0f7f6", margin="0.22,0.17"];
Web [label="Interface web\nReact / Vite"];
Api [label="API métier\nNestJS / TS"];
Data [label="Persistance privée\nPostgreSQL · fichiers", shape=cylinder];
Mail [label="Port mail\nadaptateur"];
Extraction [label="Traitement différé\nPDF natif · worker"];
Cache [label="Caches privés\nMarkdown / réponse"];
Live [label="Jev externe\nextraction structurée", fillcolor="#fff8eb", color="#b7791f"];
{rank=same; Web; Mail;}
Web -> Api [label="HTTP\nJSON"];
Api -> Data [label="ports\nSQL"];
Api -> Mail [label="port", constraint=false];
Api -> Extraction [label="hors\nHTTP"];
Extraction -> Cache [label=""];
Extraction -> Live [label="JevGateway"];
}
