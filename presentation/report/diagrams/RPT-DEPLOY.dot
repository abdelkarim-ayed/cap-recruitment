// Local logical topology, grouped resources keep labels readable on A4.
digraph Deploy {
  graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.3, ranksep=0.45,
    fontname="Liberation Sans", fontsize=14, fontcolor="#172B4D", label="Topologie locale de démonstration", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#0F766E",
    fontname="Liberation Sans", fontsize=12, fontcolor="#172B4D", margin="0.14,0.12"];
  edge [fontname="Liberation Sans", fontsize=11, color="#64748B", fontcolor="#475569", arrowsize=0.7];
  browser [label="Navigateur\nCandidat · RH · interviewer"];
  web [label="React / Vite\nRelais /api local"];
  api [label="API NestJS · un processus\nHTTP / sessions / services métier\nRunner : réveil et découverte SQL\nJevGateway : admission et transport"];
  resources [label="Ressources locales\nPostgreSQL : dossiers, tâches et tentatives\nRedis : verrou et compteurs d’admission\nFichiers privés : PDF et caches séparés\nCourrier : capture en fichier"];
  parser [label="Enfant natif\nPDF → Markdown\nSans OCR"];
  provider [label="TypeSafe / Jev\nService externe", fillcolor="#FFF8EB", color="#B7791F"];
  {rank=same; resources; parser;}
  browser -> web [label="HTTP local"];
  web -> api [label="HTTP /api"];
  api -> resources;
  api -> parser [label="IPC"];
  resources -> provider [style=invis];
  api -> provider [label="HTTPS"];
}
