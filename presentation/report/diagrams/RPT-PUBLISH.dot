// Selected publication mechanism; detailed checks are explained in Chapter 3.
digraph Publish {
  graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.35, ranksep=0.4,
    fontname="Liberation Sans", fontsize=14, fontcolor="#172B4D", label="Publication atomique", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#0F766E",
    fontname="Liberation Sans", fontsize=12, fontcolor="#172B4D", margin="0.15,0.12"];
  edge [fontname="Liberation Sans", fontsize=11, color="#172B4D", arrowsize=0.7];
  ui [label="Propriétaire : confirmer la publication\nRévisions attendues de l’offre et du plan"];
  subgraph cluster_tx {
    label="Transaction PostgreSQL"; color="#172B4D";
    lock [label="Verrouiller l’offre\nVérifier propriétaire et état"];
    checks [label="Comparer les deux révisions\nValider formulaire, extracteurs et plan sauvegardé\nUn plan vide reste valide"];
    save [label="Publier et incrémenter la révision de l’offre\nFixer la première date de publication UTC\nConserver les étapes et leur révision"];
    lock -> checks -> save;
  }
  done [label="Validation : configuration figée\nLa référence accompagne les candidatures"];
  conflict [label="Contrôle refusé : aucune publication\nConflit de révision ou configuration invalide", color="#B7791F"];
  ui -> lock;
  checks -> conflict [label="refus"];
  save -> done;
}
