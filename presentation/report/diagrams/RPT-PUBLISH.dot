// Both revision checks and reference-date write share the vacancy transaction.
digraph Publish {
  graph [rankdir=TB, bgcolor="white", pad=0.12, nodesep=0.25, ranksep=0.3,
    fontname="Liberation Sans", fontsize=13, fontcolor="#172B4D",
    label="RPT-PUBLISH · Publication atomique", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#0F766E",
    fontname="Liberation Sans", fontsize=11, fontcolor="#172B4D", margin="0.12,0.08"];
  edge [fontname="Liberation Sans", fontsize=10, color="#172B4D", fontcolor="#172B4D", arrowsize=0.65];
  ui [label="RH propriétaire : revoir l’offre et le plan sauvegardé\nPOST publish : expectedRevision\n+ expectedInterviewRevision (compteurs distincts)"];
  subgraph cluster_tx {
    label="Une transaction PostgreSQL"; color="#172B4D";
    lock [label="Verrouiller vacancies : FOR UPDATE\nMême verrou pour éditer l’offre / sauver le plan"];
    owner [label="Contrôler le propriétaire\nDéjà published ? retour inchangé, sans écrire"];
    rev [label="Transition draft → published seulement\nComparer expectedRevision à revision"];
    defs [label="Valider formulaire + tâches\nAu moins un champ non séparateur\nZéro extracteur reste valide"];
    plan [label="Lire interview_revision + interview_steps\nSur cette transaction, sous le même verrou\nComparer expectedInterviewRevision séparément"];
    valid [label="Valider le plan sauvegardé : 0 à 10 étapes\nOrdre / noms / consignes · plan vide valide\nPas d’interviewer ni de créneau exigé"];
    save [label="UPDATE vacancies : published ; revision + 1\nSi date absente : extraction_reference_date\n= date UTC de statement_timestamp()\nPlan, IDs et interview_revision inchangés"];
    lock -> owner -> rev -> defs -> plan -> valid -> save;
  }
  ui -> lock;
  commit [label="COMMIT : configuration et plan figés\nDate conservée dans les snapshots de candidature\nÉdition, fermeture et reprise ne déplacent pas la date"];
  save -> commit;
  fail [label="Échec d’un contrôle : aucune publication\nRévision périmée : 409 · contenu invalide : 400\nRelire explicitement ; pas de retry UI automatique"];
  race [label="Course avec une sauvegarde du plan\nPlan modifié d’abord : publication périmée refusée\nPublication d’abord : sauvegarde du plan refusée"];
  commit -> race [style=dashed, arrowhead=none];
  race -> fail [style=invis];
}
