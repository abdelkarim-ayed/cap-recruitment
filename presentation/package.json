{
  "name": "@recruitment/presentation",
  "private": true,
  "type": "module",
  "scripts": {
    "deck:dev": "vite deck --host 127.0.0.1 --port 5174 --strictPort",
    "deck:build": "vite build deck --outDir ../dist/deck",
    "pdf:build": "node scripts/prepare-reading-slides.mjs && node scripts/render-diagrams.mjs && node scripts/typst.mjs compile pdf/main.typ dist/status.pdf --root .",
    "diagram:render": "node scripts/render-diagrams.mjs",
    "typst": "node scripts/typst.mjs",
    "diagram:check": "node scripts/check-diagrams.mjs"
  },
  "devDependencies": {
    "@viz-js/viz": "3.31.0",
    "jsdom": "30.1.2",
    "mermaid": "12.1.0",
    "reveal.js": "6.0.2",
    "vite": "^7.0.0"
  }
}
