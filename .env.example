# Local development only. Auth secrets and deployed credentials will be separate.
DATABASE_URL=postgresql://recruitment:recruitment_local@127.0.0.1:55437/recruitment
REDIS_URL=redis://127.0.0.1:56379
PORT=3000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
# Defaults to local Mailpit SMTP. file captures mail privately without SMTP.
MAIL_DRIVER=smtp
# SMTP_USER/SMTP_PASSWORD are optional and must be provided together.
# Legacy extraction adapter; real task execution is configured separately below.
EXTRACTION_DRIVER=disabled
# Safe defaults. See LAUNCH.md before explicitly enabling synthetic live work.
PROCESSING_READER=disabled
PROCESSING_EXECUTOR=disabled
PROCESSING_RUNNER=disabled
# Jev credentials are RAM-only: use the running backend's local rotation CLI,
# never add JEV_API_KEY or a real key to this file.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MAIL_FROM=Recruitment <recruitment@example.test>
